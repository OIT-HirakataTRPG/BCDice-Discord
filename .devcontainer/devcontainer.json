{
  "name": "BCDice Discord Bot",
  "image": "node:24-slim",
  "runArgs": ["--name", "BCDice-Discord"],
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },

  // Configure tool-specific properties.
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "PKief.material-icon-theme",
        "mhutchie.git-graph"
      ]
    }
  },

  // Use 'postCreateCommand' to run commands after the container is created.
  "postCreateCommand": "cp -n .env.example .env || true && npm install",

  // Configure user
  "remoteUser": "node"
}
